// bam-readcount mutation curation pipeline configuration

params {
    samplesheet      = "${projectDir}/samplesheet.csv"
    region           = "${projectDir}/data/KRAS_region_hg38.bed"
    // Reference genomes, chosen per sample by the samplesheet "reference" column
    // (a genome version such as hg38; blank = params.genome). Each entry gives the
    // FASTA (needs a .fai next to it) and the matching SnpEff database.
    genome           = 'hg38'
    genomes          = [
        hg38: [
            fasta : '/path/to/Homo_sapiens_assembly38.fasta',
            snpeff: 'GRCh38.86',
        ],
    ]
    // other names accepted in the "reference" column (case-insensitive)
    genome_aliases   = [GRCh38: 'hg38']
    bamrc_sif        = '/path/to/bam-readcount_1.0.0.sif'
    bind_paths       = '/path/to'   // comma-separated host paths bound into the container
    min_base_qual    = 15         // bam-readcount -b
    max_warnings     = 1          // bam-readcount -w
    python           = 'python3'  // interpreter for the src/*.py scripts
    snpeff_sif       = '/path/to/snpeff_4.3t.sif'
    snpeff_datadir   = '/path/to/snpeff/4.3t/data'
    snpeff_genome    = null         // set (e.g. --snpeff_genome GRCh38.86) to override params.genomes
    // everything goes under outdir: results/, work/, pipeline_info/
    outdir           = '.'          // default: current directory
}

// Nextflow intermediate files, next to the published results
workDir = "${params.outdir}/work"

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
}

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}

process {
    executor = 'local'
    cpus     = 1
    memory   = '4 GB'

    withName: 'SNPEFF_ANN' {
        memory = '8 GB'
    }
}

profiles {
    slurm {
        process {
            executor = 'slurm'
            memory   = '8 GB'
            time     = '24h'
        }
    }
}
